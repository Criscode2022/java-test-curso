@baseUrl = http://localhost:8080
@token = replace-with-jwt

### Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "librarian@stacks.local",
  "password": "stacks"
}

### Current user
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}

### Register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Ada",
  "email": "ada@stacks.local",
  "password": "stacks1"
}

### List authors
GET {{baseUrl}}/api/authors

### List genres
GET {{baseUrl}}/api/genres

### List books
GET {{baseUrl}}/api/books

### Books by author
GET {{baseUrl}}/api/books?authorId=1

### Books by genre
GET {{baseUrl}}/api/books?genreId=2

### Books by owner
GET {{baseUrl}}/api/books?ownerId=1

### Create a genre
POST {{baseUrl}}/api/genres
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Testing",
  "description": "How we know the code works."
}

### Create an author
POST {{baseUrl}}/api/authors
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Andrew Hunt",
  "nationality": "United States",
  "birthYear": 1964
}

### Create a book. owner_id comes from the JWT, not the body
POST {{baseUrl}}/api/books
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "The Pragmatic Programmer",
  "isbn": "9780201616224",
  "publishedYear": 1999,
  "authorId": 1,
  "genreId": 2,
  "pages": 352
}

### Delete author (409 if they still have books)
DELETE {{baseUrl}}/api/authors/1
Authorization: Bearer {{token}}

### Delete genre (409 if it still has books)
DELETE {{baseUrl}}/api/genres/2
Authorization: Bearer {{token}}
