# Copy this file to .env and fill in the Neon values.
# Never commit .env.

DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/library?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/library?sslmode=require

# Local JWT signing key. Not Neon Auth. Use at least 32 characters.
JWT_SECRET=dev-only-change-me-use-at-least-32-bytes!
